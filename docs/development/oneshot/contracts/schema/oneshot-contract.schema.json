{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opendray.local/schemas/oneshot-contract.schema.json",
  "title": "OpenDray One-shot frozen contract manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "status",
    "api_base",
    "resources",
    "state_machines",
    "api",
    "events",
    "errors",
    "idempotency",
    "pagination",
    "timestamps",
    "error_envelope",
    "audit"
  ],
  "properties": {
    "contract_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "status": {
      "const": "frozen"
    },
    "api_base": {
      "const": "/api/v1/oneshot"
    },
    "resources": {
      "type": "object",
      "minProperties": 7,
      "additionalProperties": {
        "$ref": "#/$defs/resource"
      }
    },
    "state_machines": {
      "type": "object",
      "minProperties": 4,
      "additionalProperties": {
        "$ref": "#/$defs/stateMachine"
      }
    },
    "api": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/apiOperation"
      }
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/event"
      }
    },
    "errors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/error"
      }
    },
    "idempotency": {
      "type": "object"
    },
    "pagination": {
      "type": "object"
    },
    "timestamps": {
      "type": "object"
    },
    "error_envelope": {
      "type": "object"
    },
    "audit": {
      "type": "object"
    }
  },
  "$defs": {
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "type",
        "required",
        "immutable",
        "description"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "enum": [
            "string",
            "nullable_string",
            "integer",
            "nullable_integer",
            "object",
            "array",
            "timestamp",
            "nullable_timestamp",
            "enum"
          ]
        },
        "required": {
          "type": "boolean"
        },
        "immutable": {
          "type": "boolean"
        },
        "description": {
          "type": "string"
        },
        "enum": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        }
      }
    },
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id_prefix",
        "description",
        "fields",
        "invariants"
      ],
      "properties": {
        "id_prefix": {
          "type": "string",
          "pattern": "^o[a-z]{2}_$"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "fields": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/field"
          }
        },
        "invariants": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "kind",
        "description"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "enum": [
            "active",
            "quiescent",
            "terminal"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "transition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from",
        "to",
        "command",
        "guard"
      ],
      "properties": {
        "from": {
          "type": "string"
        },
        "to": {
          "type": "string"
        },
        "command": {
          "type": "string"
        },
        "guard": {
          "type": "string"
        }
      }
    },
    "stateMachine": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "initial",
        "states",
        "transitions"
      ],
      "properties": {
        "initial": {
          "type": "string"
        },
        "states": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/state"
          }
        },
        "transitions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/transition"
          }
        }
      }
    },
    "apiOperation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "protocol",
        "method",
        "path",
        "scope",
        "idempotency",
        "success_status",
        "request",
        "response",
        "audit_action",
        "description"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "protocol": {
          "type": "string",
          "enum": [
            "http",
            "websocket"
          ]
        },
        "method": {
          "type": "string",
          "enum": [
            "GET",
            "POST",
            "PATCH",
            "DELETE"
          ]
        },
        "path": {
          "type": "string",
          "pattern": "^/api/v1/oneshot/"
        },
        "scope": {
          "type": "string"
        },
        "idempotency": {
          "type": "string",
          "enum": [
            "none",
            "optional",
            "required"
          ]
        },
        "success_status": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "integer",
            "minimum": 100,
            "maximum": 599
          }
        },
        "request": {
          "type": "string"
        },
        "response": {
          "type": "string"
        },
        "audit_action": {
          "type": "string",
          "pattern": "^oneshot\\."
        },
        "description": {
          "type": "string"
        }
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "topic",
        "subject",
        "payload_required",
        "semantics"
      ],
      "properties": {
        "topic": {
          "type": "string",
          "pattern": "^oneshot\\."
        },
        "subject": {
          "type": "string"
        },
        "payload_required": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "semantics": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "http_status",
        "retryable",
        "description"
      ],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^oneshot\\."
        },
        "http_status": {
          "type": "integer",
          "minimum": 400,
          "maximum": 599
        },
        "retryable": {
          "type": "boolean"
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
